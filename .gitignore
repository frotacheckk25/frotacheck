.DS_Store

# Chave de assinatura de release do Android — NUNCA versionar.
# Perder este arquivo = nunca mais poder atualizar o app na Play Store com a
# mesma identidade. Faça backup em local seguro (gerenciador de senhas/cofre),
# fora do git.
android/upload-keystore.jks
android/key.properties
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
